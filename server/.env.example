# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/portfolio

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_32chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Admin Credentials (used during database seed)
ADMIN_EMAIL=admin@himesh.dev
ADMIN_PASSWORD=Password123!

# CORS
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Optional - for image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional - for contact form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@himesh.dev
